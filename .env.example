# Public URLs only — safe to commit as an example, never put secrets here.
# Set the same keys in Vercel project env (Production / Preview / Development).
VITE_API_URL=https://api.bizuply.com/api
VITE_CLIENT_URL=https://bizuply.com

# Local-only offline translation script (translate.js). Never a production OpenAI key.
# Never prefix OpenAI secrets with VITE_ — Vite inlines VITE_* into the browser bundle.
# OPENAI_API_KEY=
